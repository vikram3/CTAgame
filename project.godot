;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Prototype"
config/description="this is a prototype for a game"
config/version="1.0"
run/main_scene="uid://ck42ujmxyg137"
config/features=PackedStringArray("4.5", "Mobile")
boot_splash/image="uid://cv3kn4kw85384"
config/icon="res://icon.svg"
config/image=""

[autoload]

Global="*res://Scripts/Global.gd"
CollectedItems="*res://Scripts/Collected_items.gd"
TransitionManager="*res://Scripts/TransitionManager.gd"
GameData="*res://Scripts/Autoload/GameData.gd"
SceneManager="*res://Scripts/Autoload/SceneManager.gd"
AchievementManager="*res://Scripts/Autoload/AchievementManager.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=1700
window/size/mode=3
window/size/window_width_override=800
window/size/window_height_override=1700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[editor]

movie_writer/movie_file="C:/Users/singh/Videos/video.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_state_charts/plugin.cfg")

